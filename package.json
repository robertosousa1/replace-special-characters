{
  "name": "replace-special-characters",
  "version": "2.0.0",
  "description": "Remove accents and replace special Latin characters with plain equivalents",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE",
    "llms.txt"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "clean": "node -e \"const fs = require('fs'); for (const path of ['dist', 'coverage']) fs.rmSync(path, { recursive: true, force: true })\"",
    "clean:dist": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean:dist && tsc -p tsconfig-build.json",
    "lint": "biome lint src tests scripts commitlint.config.cjs vitest.config.ts",
    "lint:commit": "node scripts/lint-commit.cjs",
    "lint:fix": "biome check --write src tests scripts commitlint.config.cjs vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test:ci && npm run build",
    "prepublishOnly": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertosousa1/replace-special-characters.git"
  },
  "keywords": [
    "special-characters",
    "diacritics",
    "accents",
    "remove-accents",
    "replace-accents",
    "replace",
    "normalize",
    "unicode",
    "ascii",
    "latin",
    "transliteration",
    "slug",
    "string"
  ],
  "author": {
    "name": "Roberto Alves",
    "email": "robertosousa1@uol.com.br"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/robertosousa1/replace-special-characters/issues"
  },
  "homepage": "https://github.com/robertosousa1/replace-special-characters#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/lint": "^21.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
